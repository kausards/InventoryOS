# Dependencies — never commit; reinstall with pnpm install
node_modules/

# Environment & secrets — NEVER commit (only .env.example is allowed)
.env
.env.*
!.env.example
!.env.test.example

# Private keys and common secret filenames
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.pfx

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo

# Logs & coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# Drizzle
drizzle/meta/

# Test DB state
*.db
*.sqlite

# Design screenshots (generated; committed only explicitly)
/design/screenshots/

# Supabase local
.supabase/
