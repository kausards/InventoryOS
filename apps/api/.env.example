# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── Database (Supabase Postgres) ──────────────────
# Use pooled connection URL from Supabase dashboard (Transaction mode, port 6543)
DATABASE_URL=postgresql://growthomic_app:<password>@<host>:6543/<db>?sslmode=require&pgbouncer=true
DATABASE_URL_DIRECT=postgresql://postgres:<password>@<host>:5432/<db>?sslmode=require

# ── Supabase Auth ─────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ── Security ──────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Logging ──────────────────────────────────────
LOG_LEVEL=debug
