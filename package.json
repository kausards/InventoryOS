{
  "name": "growthomic-inventory-os",
  "version": "0.0.0",
  "private": true,
  "description": "Growthomic Inventory & Business OS — multi-tenant SaaS monorepo",
  "scripts": {
    "dev": "pnpm --filter './apps/*' run dev",
    "build": "pnpm --filter @growthomic/shared run build && pnpm --filter @growthomic/db run build && pnpm --filter './apps/*' run build",
    "build:packages": "pnpm --filter @growthomic/shared run build && pnpm --filter @growthomic/db run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:rls": "pnpm --filter @growthomic/db run test:rls",
    "db:generate": "pnpm --filter @growthomic/db run generate",
    "db:migrate": "pnpm --filter @growthomic/db run migrate",
    "db:studio": "pnpm --filter @growthomic/db run studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
